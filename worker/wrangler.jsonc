{
  "name": "babagan-p2p",
  "main": "index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "p2p.babagan.cloud", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "MeetingRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeetingRoom"] }],
  "ratelimits": [{ "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
